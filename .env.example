# Copy to .env in the project root. Leave empty until using your own provider.
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
# Exact model ID from your provider; must support Chat Completions function tools.
LLM_MODEL=deepseek-flash
LLM_TIMEOUT_SECONDS=30
LLM_MAX_TURNS=6
LLM_MAX_OUTPUT_TOKENS=700
